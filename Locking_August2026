SELECT 
    -- 1. IDENTIFICATION & DURATION
    r.session_id AS [SPID],
    -- Extracts the Stored Procedure / Object Name (Returns NULL if ad-hoc SQL)
    OBJECT_NAME(st.objectid, st.dbid) AS [ProcedureName],
    s.login_name AS [Login],
    s.host_name AS [Host],
    s.program_name AS [Program],
    DB_NAME(r.database_id) AS [Database],
    
    -- 4. EXECUTING COMMAND & TEXT
    r.command AS [Command],
    -- Extract exact statement being executed out of the batch
    SUBSTRING(
        st.text, 
        (r.statement_start_offset / 2) + 1, 
        ((CASE r.statement_end_offset 
            WHEN -1 THEN DATALENGTH(st.text) 
            ELSE r.statement_end_offset 
          END - r.statement_start_offset) / 2) + 1
    ) AS [ActiveQueryText],
    st.text AS [FullBatchText],
    r.status AS [RequestStatus],
    s.status AS [SessionStatus],
    
    -- Elapsed Time formatted as HH:MM:SS.ms
    RIGHT('00' + CAST(r.total_elapsed_time / 3600000 AS VARCHAR), 2) + ':' +
    RIGHT('00' + CAST((r.total_elapsed_time % 3600000) / 60000 AS VARCHAR), 2) + ':' +
    RIGHT('00' + CAST((r.total_elapsed_time % 60000) / 1000 AS VARCHAR), 2) + '.' +
    RIGHT('000' + CAST(r.total_elapsed_time % 1000 AS VARCHAR), 3) AS [ElapsedTime],
    
    -- 2. BLOCKING INFORMATION
    r.blocking_session_id AS [BlockedBy_SPID],
    -- Is this session actively blocking someone else?
    CASE 
        WHEN EXISTS (SELECT 1 FROM sys.dm_exec_requests WHERE blocking_session_id = r.session_id) 
        THEN '!!! HEAD BLOCKER !!!' 
        ELSE '' 
    END AS [IsBlocker],

    -- 3. WAITS & RESOURCE CONSUMPTION
    r.wait_type AS [WaitType],
    r.wait_time / 1000.0 AS [WaitTime_Sec],
    r.last_wait_type AS [LastWaitType],
    r.cpu_time AS [CPU_ms],
    r.reads AS [LogicalReads],
    r.writes AS [Writes],
    r.granted_query_memory * 8 / 1024 AS [GrantedMem_MB],
    
    -- 5. EXECUTION PLAN & TIMINGS
    --qp.query_plan AS [XML_ExecutionPlan],
    r.start_time AS [RequestStartTime],
    s.last_request_start_time AS [SessionLastRequestTime]

FROM sys.dm_exec_sessions s
-- Left join requests so sleeping transactions holding locks/blocks aren't lost
LEFT JOIN sys.dm_exec_requests r ON s.session_id = r.session_id
OUTER APPLY sys.dm_exec_sql_text(r.sql_handle) st
OUTER APPLY sys.dm_exec_query_plan(r.plan_handle) qp
WHERE 
    s.is_user_process = 1                          -- Filter out background system processes
    AND s.session_id <> @@SPID                     -- Ignore this query itself
    AND (
        r.session_id IS NOT NULL                   -- Currently executing queries
        OR EXISTS (                                -- OR sleeping sessions blocking someone else
            SELECT 1 FROM sys.dm_exec_requests 
            WHERE blocking_session_id = s.session_id
        )
    )
ORDER BY 
    [IsBlocker] DESC,                              -- Bring head blockers to the top
    r.blocking_session_id DESC, 
    r.total_elapsed_time DESC;                     -- Longest running queries next
